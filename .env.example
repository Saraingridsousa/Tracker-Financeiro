# Copie para %LOCALAPPDATA%/TrackerFinanceiro/config.env (fora do checkout).
# Alternativa: configure TRACKER_ENV_FILE com o caminho privado do arquivo.
# Não use VITE_ e nunca envie estes valores ao chat/Git.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
TRACKER_PORT=3001
# TRACKER_DATA_DIR=C:/caminho/privado/TrackerFinanceiro

# Opcional: acesso privado via Tailscale Serve; preencher os dois campos juntos.
# TRACKER_PRIVATE_ORIGIN=https://pc.rede.ts.net
# TRACKER_PRIVATE_USER=proprietaria@example.com
# Consulte docs/private-access.md antes de ativar. Não usar Funnel.

# Mapeamento privado de itens já autorizados; padrão: mesmo diretório de dados.
# TRACKER_CONNECTIONS_FILE=C:/Users/seu-usuario/AppData/Local/TrackerFinanceiro/connections.json
